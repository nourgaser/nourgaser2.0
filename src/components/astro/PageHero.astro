---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  kicker: string;
  title: string;
  description?: string;
  image: ImageMetadata;
  imageAlt?: string;
  ctaHref?: string;
  ctaLabel?: string;
  sectionId?: string;
  sectionLabel?: string;
}

const {
  kicker,
  title,
  description,
  image,
  imageAlt,
  ctaHref,
  ctaLabel,
  sectionId,
  sectionLabel,
} = Astro.props;

const shouldRenderCta = Boolean(ctaHref && ctaLabel);
---

<section
  class="page-hero"
  data-ngx-section={sectionId ?? 'page-hero'}
  data-ngx-label={sectionLabel ?? title}
>
  <div class="page-hero-media" aria-hidden="true">
    <Picture
      src={image}
      alt={imageAlt ?? `${title} hero image`}
      formats={['avif', 'webp']}
      widths={[640, 960, 1280, 1600, 1920]}
      sizes="100vw"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </div>
  <div class="page-hero-inner">
    <div class="page-hero-copy">
      <p class="page-hero-kicker">{kicker}</p>
      <h1>{title}</h1>
      {description && <p class="page-hero-description">{description}</p>}
      {shouldRenderCta && (
        <a class="page-hero-cta" href={ctaHref}>
          {ctaLabel}
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    margin-top: var(--space-2);
    min-height: 390px;
    border-top: 1px solid var(--hero-edge-border);
    border-bottom: 1px solid var(--hero-edge-border);
    display: flex;
    align-items: center;
  }

  .page-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(3, 8, 17, 0.3), rgba(3, 8, 17, 0.55));
    z-index: 1;
    pointer-events: none;
  }

  .page-hero-media {
    position: absolute;
    inset: 0;
  }

  .page-hero-media :global(picture),
  .page-hero-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .page-hero-media :global(img) {
    object-fit: cover;
    object-position: center;
  }

  .page-hero-inner {
    position: relative;
    z-index: 2;
    width: var(--content-shell-width-desktop);
    margin: 0 auto;
    padding: var(--space-8) 0;
  }

  .page-hero-inner::before {
    content: '';
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    top: var(--space-2);
    bottom: var(--space-2);
    background: rgba(8, 13, 23, 0.42);
    border-top: 1px solid var(--hero-strip-border);
    border-bottom: 1px solid var(--hero-strip-border);
    pointer-events: none;
    
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .page-hero-copy {
    position: relative;
    z-index: 1;
    width: min(600px, 100%);
    display: grid;
    gap: var(--space-3);
  }

  .page-hero-kicker {
    margin: 0;
    font-size: clamp(var(--text-xl), 3.3vw, 2.1rem);
    line-height: var(--leading-tight);
  }

  .page-hero h1 {
    margin: 0;
    font-size: clamp(var(--text-2xl), 5.4vw, 4rem);
    line-height: var(--leading-tight);
  }

  .page-hero-description {
    margin: 0;
    font-size: clamp(var(--text-base), 2vw, var(--text-xl));
    max-width: 40ch;
  }

  .page-hero-cta {
    margin-top: var(--space-4);
    display: inline-block;
    width: fit-content;
    padding: var(--space-2) var(--space-4);
    background: var(--button-muted-bg);
    border: 1px solid var(--button-muted-border);
    color: #e8f0ff;
    text-decoration: none;
    font-size: var(--text-sm);
  }

  .page-hero-cta:hover {
    background: var(--button-muted-hover);
  }

  @media (max-width: 720px) {
    .page-hero {
      margin-top: var(--space-4);
      min-height: 280px;
    }

    .page-hero-media :global(img) {
      object-position: 60% center;
    }

    .page-hero-inner {
      width: var(--content-shell-width-mobile);
      padding: var(--space-6) 0;
    }

    .page-hero-copy {
      width: min(440px, 100%);
    }

    .page-hero-inner::before {
      top: var(--space-1);
      bottom: var(--space-1);
    }

    .page-hero-kicker {
      font-size: var(--text-lg);
    }

    .page-hero-description {
      font-size: var(--text-base);
    }
  }
</style>
