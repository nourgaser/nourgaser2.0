---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

type ProjectMediaItem = CollectionEntry<'projects'>['data']['media'][number];
type ProjectLinks = CollectionEntry<'projects'>['data']['links'];

interface Props {
  title: string;
  media: ProjectMediaItem[];
  tags: string[];
  links?: ProjectLinks;
  previousTitle?: string;
  previousSlug?: string;
  nextTitle?: string;
  nextSlug?: string;
}

const {
  title,
  media,
  tags,
  links,
  previousTitle,
  previousSlug,
  nextTitle,
  nextSlug,
} = Astro.props;

const previewMedia = media;
const leadMedia = media[0];
const sourceLinks = [links?.source].filter((value): value is string => Boolean(value));
const liveLinks = [links?.live].filter((value): value is string => Boolean(value));
---

<section class="project-showcase" data-ngx-section="portfolio-showcase" data-ngx-label="Project Showcase">
  <div class="showcase-tabs" aria-label="Related project tabs">
    {previousSlug
      ? <a href={`/portfolio/${previousSlug}/#project-showcase`} data-project-switch="true" class="showcase-tab showcase-tab--muted showcase-tab--prev"><span class="showcase-tab-arrow" aria-hidden="true">‹</span><span class="showcase-tab-label">{previousTitle}</span></a>
      : <span class="showcase-tab showcase-tab--muted showcase-tab--disabled showcase-tab--prev"><span class="showcase-tab-arrow" aria-hidden="true">‹</span><span class="showcase-tab-label">{previousTitle ?? 'First project'}</span></span>
    }
    <span class="showcase-tab showcase-tab--active">{title}</span>
    {nextSlug
      ? <a href={`/portfolio/${nextSlug}/#project-showcase`} data-project-switch="true" class="showcase-tab showcase-tab--muted showcase-tab--next"><span class="showcase-tab-label">{nextTitle}</span><span class="showcase-tab-arrow" aria-hidden="true">&#8250;</span></a>
      : <span class="showcase-tab showcase-tab--muted showcase-tab--disabled showcase-tab--next"><span class="showcase-tab-label">{nextTitle ?? 'Last project'}</span><span class="showcase-tab-arrow" aria-hidden="true">&#8250;</span></span>
    }
  </div>

  <div class="showcase-shell">
    {
      leadMedia && (
        <figure class="showcase-hero" data-gallery-main>
          {leadMedia.isVideo ? (
            <video controls preload="metadata" playsinline>
              <source src={typeof leadMedia.path === 'string' ? leadMedia.path : undefined} type="video/mp4" />
            </video>
          ) : typeof leadMedia.path === 'string' ? (
            <img src={leadMedia.path} alt={leadMedia.alt ?? `${title} preview`} loading="eager" decoding="async" />
          ) : (
            <Picture
              src={leadMedia.path}
              alt={leadMedia.alt ?? `${title} preview`}
              formats={['avif', 'webp']}
              width={1400}
              height={875}
              sizes="(min-width: 1200px) 900px, 100vw"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          )}
        </figure>
      )
    }

    {
      previewMedia.length > 1 && (
        <ul class="showcase-strip" aria-label={`${title} gallery previews`}>
          {previewMedia.map((item, index) => (
            <li class="showcase-thumb-item">
              <button
                type="button"
                class:list={['showcase-thumb-button', { 'showcase-thumb-button--selected': index === 0 }]}
                data-gallery-thumb="true"
                aria-pressed={index === 0 ? 'true' : 'false'}
                aria-label={`Set preview ${index + 1} as main media`}
              >
                {item.isVideo ? (
                  <video preload="metadata" playsinline muted>
                    <source src={typeof item.path === 'string' ? item.path : undefined} type="video/mp4" />
                  </video>
                ) : typeof item.path === 'string' ? (
                  <img src={item.path} alt={item.alt ?? `${title} preview ${index + 1}`} loading="lazy" decoding="async" />
                ) : (
                  <Picture
                    src={item.path}
                    alt={item.alt ?? `${title} preview ${index + 1}`}
                    formats={['avif', 'webp']}
                    width={320}
                    height={200}
                    sizes="(min-width: 860px) 180px, 33vw"
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <span class="showcase-thumb-tag">{item.isVideo ? 'video' : 'image'}</span>
              </button>
            </li>
          ))}
        </ul>
      )
    }

    <div class="showcase-meta">
      <section class="showcase-meta-block" aria-label="Tech stack">
        <h2>Tech stack</h2>
        <ul>
          {tags.map((tag) => <li>{tag}</li>)}
        </ul>
      </section>

      <section class="showcase-meta-block" aria-label="Project links">
        <h2>Source code</h2>
        {
          sourceLinks.length > 0
            ? sourceLinks.map((url) => (
              <p>
                <a href={url} target="_blank" rel="noreferrer">{url}</a>
              </p>
            ))
            : <p>Private repository.</p>
        }

        <h2 class="showcase-live-heading">Live demo</h2>
        {
          liveLinks.length > 0
            ? liveLinks.map((url) => (
              <p>
                <a href={url} target="_blank" rel="noreferrer">{url}</a>
              </p>
            ))
            : <p>No public demo.</p>
        }
      </section>
    </div>
  </div>
</section>

<style>
  .project-showcase {
    display: grid;
    gap: var(--space-3);
  }

  .showcase-tabs {
    display: grid;
    grid-template-columns: 1fr minmax(280px, 2fr) 1fr;
    border: 2px solid var(--portfolio-gallery-border);
    background: color-mix(in srgb, var(--bg-nav) 90%, transparent);
  }

  .showcase-tab {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-base);
    line-height: 1.2;
    text-align: center;
    border-right: 2px solid var(--portfolio-gallery-border);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .showcase-tab-label {
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }

  .showcase-tab-arrow {
    flex-shrink: 0;
    font-size: 1.25em;
    line-height: 1;
    opacity: 0.6;
  }

  .showcase-tab--prev {
    justify-content: flex-start;
  }

  .showcase-tab--next {
    justify-content: flex-end;
  }

  .showcase-tab:last-child {
    border-right: 0;
  }

  .showcase-tab--active {
    background: var(--portfolio-gallery-tab-active);
    color: var(--text-primary);
  }

  .showcase-tab--muted {
    background: var(--portfolio-gallery-tab-muted);
    color: var(--text-primary);
    opacity: 0.76;
    text-decoration: none;
    transition: opacity 120ms ease;
  }

  a.showcase-tab--muted:hover,
  a.showcase-tab--muted:focus-visible {
    opacity: 1;
    text-decoration: none;
  }

  :global(main[data-project-loading="true"]) a.showcase-tab[data-project-switch="true"] {
    pointer-events: none;
    opacity: 0.42;
  }

  .showcase-tab--disabled {
    cursor: default;
    opacity: 0.38;
  }

  .showcase-shell {
    background: var(--portfolio-gallery-bg);
    border: 2px solid var(--portfolio-gallery-border);
  }

  .showcase-hero {
    margin: 0;
    border-bottom: 2px solid var(--portfolio-gallery-border);
    background: color-mix(in srgb, var(--bg-nav) 86%, transparent);
  }

  .showcase-hero :global(picture),
  .showcase-hero :global(img),
  .showcase-hero video {
    display: block;
    width: 100%;
    height: auto;
  }

  .showcase-hero :global(img),
  .showcase-hero video {
    min-height: 240px;
    max-height: 660px;
    object-fit: cover;
  }

  .showcase-strip {
    list-style: none;
    margin: 0;
    padding: var(--space-4);
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    border-bottom: 2px solid var(--portfolio-gallery-border);
  }

  .showcase-thumb-item {
    border: 1px solid var(--portfolio-gallery-border);
    background: color-mix(in srgb, var(--bg-nav) 82%, transparent);
  }

  .showcase-thumb-button {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    border: 0;
    background: transparent;
    padding: 0;
    cursor: pointer;
    opacity: 0.36;
    filter: saturate(0.72) brightness(0.78);
    transition: opacity 120ms ease, filter 120ms ease, box-shadow 120ms ease;
  }

  .showcase-thumb-button:focus-visible {
    outline: 1px solid var(--text-accent);
    outline-offset: -1px;
  }

  .showcase-thumb-button:hover {
    opacity: 0.65;
    filter: saturate(0.88) brightness(0.9);
  }

  .showcase-thumb-button--selected {
    opacity: 1;
    filter: none;
    box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--text-accent) 70%, transparent);
  }

  .showcase-thumb-tag {
    position: absolute;
    right: var(--space-1);
    bottom: var(--space-1);
    display: inline-block;
    padding: 2px 6px;
    border: 1px solid var(--portfolio-gallery-border);
    background: color-mix(in srgb, var(--bg-nav) 84%, transparent);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: color-mix(in srgb, var(--text-primary) 88%, transparent);
    pointer-events: none;
  }

  .showcase-strip :global(picture),
  .showcase-strip :global(img),
  .showcase-strip video {
    width: 100%;
    height: 100%;
    display: block;
  }

  .showcase-strip :global(img),
  .showcase-strip video {
    object-fit: cover;
  }

  .showcase-meta {
    display: grid;
    grid-template-columns: minmax(220px, 1fr) minmax(240px, 1fr);
    background: color-mix(in srgb, var(--bg-nav) 90%, transparent);
  }

  .showcase-meta-block {
    padding: var(--space-4) var(--space-5) var(--space-5);
    border-right: 2px solid var(--portfolio-gallery-border);
  }

  .showcase-meta-block:last-child {
    border-right: 0;
  }

  .showcase-meta-block h2 {
    margin: 0 0 var(--space-3);
    font-size: clamp(var(--text-xl), 2.2vw, var(--text-2xl));
    line-height: 1.2;
  }

  .showcase-meta-block ul {
    margin: 0;
    padding-left: var(--space-5);
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-base);
  }

  .showcase-meta-block p {
    margin: 0;
    font-size: var(--text-base);
  }

  .showcase-meta-block p + p {
    margin-top: var(--space-2);
  }

  .showcase-meta-block a {
    color: var(--text-primary);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12em;
    word-break: break-word;
  }

  .showcase-live-heading {
    margin-top: var(--space-5);
  }

  @media (max-width: 860px) {
    .showcase-tabs {
      grid-template-columns: 1fr;
    }

    .showcase-tab {
      border-right: 0;
      border-bottom: 2px solid var(--portfolio-gallery-border);
    }

    .showcase-tab:last-child {
      border-bottom: 0;
    }

    .showcase-meta {
      grid-template-columns: 1fr;
    }

    .showcase-meta-block {
      border-right: 0;
      border-bottom: 2px solid var(--portfolio-gallery-border);
    }

    .showcase-meta-block:last-child {
      border-bottom: 0;
    }
  }
</style>
