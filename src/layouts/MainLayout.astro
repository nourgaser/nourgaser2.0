---
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';

import Logo from '../assets/icons/logo.svg';
import NgxosShield from '../assets/icons/ngxos-shield.svg';
import NgxosRoot from '../components/svelte/ngxos/NgxosRoot.svelte';

import '../styles/reset.css';
import '../styles/tokens.css';
import '../styles/themes.css';
import '../styles/ngxos.css';
import '../styles/global.css';
import '../styles/animations.css';
import { heroImages } from '../data/image-assets';
import { siteShellContent } from '../data/site-shell';

export interface Props {
  title: string;
  seoTitle?: string;
  description?: string;
  ogImage?: ImageMetadata | string;
  ogType?: 'website' | 'article';
}

const {
  title,
  seoTitle,
  description = 'nourgaser.com — personal portfolio',
  ogImage = heroImages.spaceship,
  ogType = 'website',
} = Astro.props;

const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const pageTitle = seoTitle ?? `${title} | nourgaser`;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const robots = 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1';

const currentPath = Astro.url.pathname;
const isActiveNavLink = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`);

let ogImageUrl: string;

if (typeof ogImage === 'string') {
  ogImageUrl = ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteUrl).toString();
} else {
  const optimizedOgImage = await getImage({
    src: ogImage,
    width: 1200,
    height: 630,
    format: 'jpg',
    quality: 82,
    fit: 'cover',
  });

  ogImageUrl = new URL(optimizedOgImage.src, siteUrl).toString();
}

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl.toString()}#website`,
      url: siteUrl.toString(),
      name: 'nourgaser',
      description,
      inLanguage: 'en',
    },
    {
      '@type': 'Person',
      '@id': `${siteUrl.toString()}#person`,
      name: siteShellContent.footer.copyrightOwner,
      url: siteUrl.toString(),
      sameAs: siteShellContent.footer.socialLinks.map((link) => link.href),
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: pageTitle,
      description,
      isPartOf: { '@id': `${siteUrl.toString()}#website` },
      about: { '@id': `${siteUrl.toString()}#person` },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: ogImageUrl,
      },
      inLanguage: 'en',
    },
  ],
};

const currentYear = new Date().getFullYear();
const projectSlugs = (await getCollection('projects')).map((project) => project.id);
---

<html lang="en" data-theme="default">
  <head>
    <script is:inline>
      try {
        const power = localStorage.getItem('ngx.power');
        const theme = localStorage.getItem('ngx.theme');
        const validThemes = ['default', 'vgcolors', 'ubuntu', 'fedora'];
        if (power === 'on') {
          document.documentElement.setAttribute('data-ngxos', 'on');
          document.documentElement.setAttribute('data-theme', validThemes.includes(theme) ? theme : 'default');
        }
      } catch {}
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="author" content={siteShellContent.footer.copyrightOwner} />
    <meta name="theme-color" content="#03070f" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Ubuntu+Mono:ital,wght@0,400;0,700;1,400;1,700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Ubuntu+Mono:ital,wght@0,400;0,700;1,400;1,700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Ubuntu+Mono:ital,wght@0,400;0,700;1,400;1,700&display=swap"
      />
    </noscript>

    <meta property="og:site_name" content="nourgaser" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} preview image`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
  </head>
  <body>
    <header class="site-header" data-ngx-section="site-header" data-ngx-label="Header" data-ngx-route="/">
      <nav aria-label="Primary">
        <a class="site-logo-link" href="/" aria-label="Go to site start">
          <Logo class="site-logo" aria-hidden="true" focusable="false" />
        </a>
        <div class="site-nav-links site-nav-links-desktop">
          {
            siteShellContent.navLinks.map((link) => (
              <a href={link.href} aria-current={isActiveNavLink(link.href) ? 'page' : undefined}>{link.label}</a>
            ))
          }
        </div>
        <details class="site-nav-menu">
          <summary class="site-nav-toggle" aria-label="Toggle primary menu">
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
          </summary>
          <div class="site-nav-links site-nav-links-mobile" id="primary-nav-links-mobile">
            {
              siteShellContent.navLinks.map((link) => (
                <a href={link.href} aria-current={isActiveNavLink(link.href) ? 'page' : undefined}>{link.label}</a>
              ))
            }
          </div>
        </details>
      </nav>
    </header>

    <slot />

    <footer class="site-footer" data-ngx-section="site-footer" data-ngx-label="Footer" data-ngx-route="/">
      <div class="site-footer-inner">
        <div class="site-footer-center">
          <p class="site-footer-powered">
            <button type="button" data-ngx-command="power" aria-label="Toggle ngxos" class="ngx-power-button">
              <NgxosShield aria-hidden="true" focusable="false" />
            </button>
            <span>{siteShellContent.footer.poweredBy}</span>
          </p>
          <div data-ngx-slot="theme-dock"></div>
          <p class="site-footer-credit">{siteShellContent.footer.credit}</p>
          <p class="site-footer-copyright">&#169; {currentYear} {siteShellContent.footer.copyrightOwner}. All rights reserved.</p>
        </div>
        <div class="site-footer-social" aria-label="Social links">
          <div class="site-footer-social-icons">
            {
              siteShellContent.footer.socialLinks.map((link) => (
                <a href={link.href} target="_blank" rel="noreferrer" aria-label={link.label}>
                  {link.icon === 'facebook' && (
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M13 22v-8h3l1-4h-4V7c0-.77.23-1 1-1h3V2h-4c-3 0-5 2-5 5v3H5v4h3v8h5z" fill="currentColor"></path>
                    </svg>
                  )}
                  {link.icon === 'github' && (
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.52-1.34-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.75 1.18 1.75 1.18 1.02 1.76 2.68 1.25 3.34.96.1-.74.4-1.25.73-1.53-2.55-.29-5.24-1.27-5.24-5.67 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.14 1.19a10.93 10.93 0 0 1 5.72 0c2.18-1.5 3.14-1.19 3.14-1.19.62 1.58.23 2.75.11 3.04.74.8 1.18 1.83 1.18 3.08 0 4.41-2.69 5.38-5.25 5.66.41.35.78 1.04.78 2.1 0 1.51-.01 2.72-.01 3.09 0 .31.2.67.79.55A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z" fill="currentColor"></path>
                    </svg>
                  )}
                  {link.icon === 'linkedin' && (
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M5 3a2 2 0 1 1 0 4 2 2 0 0 1 0-4zm-2 6h4v12H3V9zm6 0h3.8v1.64h.05c.53-1 1.84-2.05 3.79-2.05 4.05 0 4.8 2.67 4.8 6.14V21h-4v-5.69c0-1.36-.02-3.11-1.9-3.11-1.9 0-2.19 1.49-2.19 3.01V21H9V9z" fill="currentColor"></path>
                    </svg>
                  )}
                </a>
              ))
            }
          </div>
          <p class="site-footer-handle">{siteShellContent.footer.socialHandle}</p>
        </div>
      </div>
    </footer>

    <script>
      const navMenu = document.querySelector('.site-nav-menu');

      if (navMenu instanceof HTMLDetailsElement) {
        const closeMenu = () => {
          navMenu.open = false;
        };

        document.addEventListener('click', (event) => {
          if (!navMenu.open) {
            return;
          }

          if (!(event.target instanceof Node)) {
            return;
          }

          if (!navMenu.contains(event.target)) {
            closeMenu();
          }
        });

        navMenu.querySelectorAll('.site-nav-links a').forEach((link) => {
          link.addEventListener('click', closeMenu);
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && navMenu.open) {
            closeMenu();
          }
        });
      }
    </script>

    <NgxosRoot client:idle projectSlugs={projectSlugs} />
  </body>
</html>
