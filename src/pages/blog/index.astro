---
import MainLayout from '../../layouts/MainLayout.astro';
import PageHero from '../../components/astro/PageHero.astro';
import { blogPageContent } from '../../data/pages/blog';
---

<MainLayout title="Blog" description={blogPageContent.seoDescription}>
  <main class="blog-page" data-ngx-section="blog" data-ngx-label="Blog" data-ngx-focusable="true" data-ngx-route="/blog">
    <PageHero
      kicker={blogPageContent.hero.kicker}
      title={blogPageContent.hero.title}
      description={blogPageContent.hero.description}
      image={blogPageContent.hero.image}
      sectionId={blogPageContent.hero.sectionId}
      sectionLabel={blogPageContent.hero.sectionLabel}
    />

    <section class="blog-shell" data-ngx-section="blog-index" data-ngx-label="Blog Index" data-ngx-focusable="true">
      <h2>{blogPageContent.latestEntriesHeading}</h2>
      <div class="blog-list">
        {
          blogPageContent.entries.map((entry) => (
            <article class="blog-card">
              <h3>{entry.title}</h3>
              <p>{entry.summary}</p>
              <p>
                <a href={entry.href}>{entry.label}</a>
              </p>
            </article>
          ))
        }
      </div>
    </section>
  </main>
</MainLayout>

<style>
  .blog-page {
    background: #03070f;
    padding-bottom: var(--space-14);
  }

  .blog-shell {
    width: var(--content-shell-width-desktop);
    margin: var(--space-8) auto;
  }

  .blog-shell h2 {
    margin: 0 0 var(--space-4);
    font-size: clamp(var(--text-xl), 3vw, 2.25rem);
    line-height: var(--leading-tight);
  }

  .blog-list {
    display: grid;
    gap: var(--space-5);
  }

  .blog-card {
    background: var(--surface-panel);
    border: 1px solid var(--border-muted-strong);
    padding: var(--space-5);
    display: grid;
    gap: var(--space-3);
  }

  .blog-card h3,
  .blog-card p {
    margin: 0;
  }

  .blog-card a {
    color: var(--text-accent);
    text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--text-accent) 40%, transparent);
    padding: var(--space-1) var(--space-3);
  }

  @media (max-width: 720px) {
    .blog-page {
      padding-bottom: var(--space-10);
    }

    .blog-shell {
      width: var(--content-shell-width-mobile);
      margin-top: var(--content-shell-margin-top-mobile);
    }
  }
</style>
