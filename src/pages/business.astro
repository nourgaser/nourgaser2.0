---
import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/astro/PageHero.astro';
import {
  coreExpertise,
  currentProjectNotes,
  education,
  experience,
  featuredProfessionalWork,
  professionalSummary,
} from '../data/professional';
import { skillCategories } from '../data/skills';
import { businessPageContent } from '../data/pages/business';
---

<MainLayout title="Business" description={businessPageContent.seoDescription}>
  <main class="business-page" data-ngx-section="business" data-ngx-label="Business" data-ngx-focusable="true" data-ngx-route="/business">
    <PageHero
      kicker={businessPageContent.hero.kicker}
      title={businessPageContent.hero.title}
      description={professionalSummary.headline}
      image={businessPageContent.hero.image}
      sectionId={businessPageContent.hero.sectionId}
      sectionLabel={businessPageContent.hero.sectionLabel}
      ctaHref={businessPageContent.hero.ctaHref}
      ctaLabel={businessPageContent.hero.ctaLabel}
    />

    <section id="business-profile" class="business-shell" data-ngx-section="business-summary" data-ngx-label="Business Summary">
      <article class="business-panel">
        <p class="business-headline">{professionalSummary.blurb}</p>
        <p>{professionalSummary.businessDescription}</p>
      </article>
    </section>

    <section class="business-shell business-grid" data-ngx-section="core-expertise" data-ngx-label="Core Expertise">
      {
        coreExpertise.map((area) => (
          <article class="business-panel">
            <h2>{area.title}</h2>
            <p>{area.description}</p>
          </article>
        ))
      }
    </section>

    <section class="business-shell" data-ngx-section="featured-work" data-ngx-label="Featured Work">
      <h2 class="business-section-title">{businessPageContent.sections.featuredWorkTitle}</h2>
      <div class="business-list">
        {
          featuredProfessionalWork.map((item) => (
            <article class="business-panel">
              {item.category && <p class="business-meta">{item.category}</p>}
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              {item.url && (
                <p>
                  <a href={item.url} target="_blank" rel="noreferrer">{item.url}</a>
                </p>
              )}
            </article>
          ))
        }
      </div>
    </section>

    <section class="business-shell business-columns" data-ngx-section="experience-and-education" data-ngx-label="Experience and Education">
      <article>
        <h2 class="business-section-title">{businessPageContent.sections.experienceTitle}</h2>
        <div class="business-list">
          {
            experience.map((entry) => (
              <article class="business-panel">
                <h3>{entry.role}</h3>
                <p>{entry.organization}</p>
                <p class="business-meta">{entry.period}</p>
                {entry.location && <p class="business-meta">{entry.location}</p>}
                {entry.notes && <p>{entry.notes}</p>}
              </article>
            ))
          }
        </div>
      </article>

      <article>
        <h2 class="business-section-title">{businessPageContent.sections.academicBackgroundTitle}</h2>
        <div class="business-list">
          {
            education.map((entry) => (
              <article class="business-panel">
                <h3>{entry.degree}</h3>
                <p>{entry.institution}</p>
                <p class="business-meta">{entry.period}</p>
                {entry.details && <p>{entry.details}</p>}
              </article>
            ))
          }
        </div>
      </article>
    </section>

    <section class="business-shell" data-ngx-section="skills" data-ngx-label="Skills">
      <h2 class="business-section-title">{businessPageContent.sections.skillsTitle}</h2>
      <div class="business-list">
        {
          skillCategories.map((category) => (
            <article class="business-panel">
              <h3>{category.name}</h3>
              <ul class="business-tags">
                {category.items.map((item) => <li>{item}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section class="business-shell" data-ngx-section="current-project-notes" data-ngx-label="Current Project Notes">
      <h2 class="business-section-title">{businessPageContent.sections.currentNotesTitle}</h2>
      <article class="business-panel">
        <ul class="business-notes">
          {currentProjectNotes.map((note) => <li>{note}</li>)}
        </ul>
      </article>
    </section>
  </main>
</MainLayout>

<style>
  .business-page {
    background: #03070f;
    padding-bottom: var(--space-14);
  }

  .business-shell {
    width: var(--content-shell-width-desktop);
    margin: var(--space-8) auto;
  }

  .business-meta {
    color: var(--text-accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--text-sm);
  }

  .business-headline {
    margin: 0;
    font-size: clamp(var(--text-base), 2vw, var(--text-xl));
  }

  .business-section-title {
    margin: 0;
    font-size: clamp(var(--text-xl), 3vw, 2.25rem);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-4);
  }

  .business-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
    margin-bottom: var(--space-10);
  }

  .business-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
  }

  .business-list {
    display: grid;
    gap: var(--space-5);
  }

  .business-panel {
    padding: var(--space-5);
    background: var(--surface-panel);
    border: 1px solid var(--border-muted-strong);
    display: grid;
    gap: var(--space-3);
  }

  .business-panel h2,
  .business-panel h3,
  .business-panel p {
    margin: 0;
  }

  .business-panel a {
    color: var(--text-accent);
  }

  .business-tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .business-tags li {
    padding: var(--space-1) var(--space-3);
    border: 1px solid color-mix(in srgb, var(--text-accent) 38%, transparent);
    font-size: var(--text-sm);
  }

  .business-notes {
    margin: 0;
    padding-left: var(--space-5);
    display: grid;
    gap: var(--space-3);
  }

  @media (max-width: 900px) {
    .business-columns {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }

  @media (max-width: 720px) {
    .business-page {
      padding-bottom: var(--space-10);
    }

    .business-shell {
      width: var(--content-shell-width-mobile);
      margin-top: var(--content-shell-margin-top-mobile);
    }
  }
</style>
