---
import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/astro/PageHero.astro';
import { hobbiesPageContent } from '../data/pages/hobbies';
---

<MainLayout
  title="Hobbies"
  description={hobbiesPageContent.seoDescription}
  ogImage={hobbiesPageContent.hero.image}
>
  <main class="hobbies-page" data-ngx-section="hobbies" data-ngx-label="Hobbies" data-ngx-focusable="true" data-ngx-route="/hobbies">
    <PageHero
      kicker={hobbiesPageContent.hero.kicker}
      title={hobbiesPageContent.hero.title}
      description={hobbiesPageContent.hero.description}
      image={hobbiesPageContent.hero.image}
      sectionId={hobbiesPageContent.hero.sectionId}
      sectionLabel={hobbiesPageContent.hero.sectionLabel}
    />

    {
      hobbiesPageContent.cards.map((card) => (
        <section
          class="hobby-card"
          aria-labelledby={card.headingId}
          data-ngx-section={card.sectionId}
          data-ngx-label={card.sectionLabel}
          data-ngx-focusable="true"
        >
          <h2 id={card.headingId}>{card.title}</h2>
          <p>{card.description}</p>
          {
            card.points && (
              <ul>
                {card.points.map((point) => <li>{point}</li>)}
              </ul>
            )
          }
        </section>
      ))
    }
  </main>
</MainLayout>

<style>
  .hobbies-page {
    background: #03070f;
    padding-bottom: var(--space-14);
  }

  .hobby-card {
    width: var(--content-shell-width-desktop);
    margin: var(--space-8) auto;
    position: relative;
    padding: var(--space-5);
    border: 1px solid var(--border-muted-strong);
    background: var(--surface-panel);
    display: grid;
    gap: var(--space-3);
  }

  .hobby-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--text-accent) 70%, white), transparent);
  }

  .hobby-card h2,
  .hobby-card p,
  .hobby-card ul {
    margin: 0;
  }

  .hobby-card h2 {
    font-size: clamp(1.25rem, 2.1vw, 1.8rem);
    line-height: var(--leading-tight);
  }

  .hobby-card ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  .hobby-card li {
    position: relative;
    padding-left: var(--space-5);
  }

  .hobby-card li::before {
    content: '>_';
    position: absolute;
    left: 0;
    color: var(--text-accent);
    font-size: 0.85em;
  }

  @media (max-width: 780px) {
    .hobbies-page {
      padding-bottom: var(--space-10);
    }

    .hobby-card {
      width: var(--content-shell-width-mobile);
      margin-top: var(--content-shell-margin-top-mobile);
      padding: var(--space-4);
    }
  }
</style>
