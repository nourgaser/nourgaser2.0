---
import MainLayout from '../layouts/MainLayout.astro';
import { homePageContent } from '../data/pages/home';
---

<MainLayout title="Home" description={homePageContent.seoDescription}>
  <main class="about-page" data-ngx-section="about" data-ngx-label="About Me" data-ngx-focusable="true" data-ngx-route="/">
    <section class="about-hero" data-ngx-section="about-intro" data-ngx-label="About Intro">
      <div class="about-hero-inner">
        <div class="about-hero-copy">
          <p class="about-kicker">{homePageContent.hero.kicker}</p>
          <p class="about-intro-text">{homePageContent.hero.introText}</p>
          <a class="about-cta" href={homePageContent.hero.ctaHref}>{homePageContent.hero.ctaLabel}</a>
        </div>
      </div>
    </section>

    {
      homePageContent.sections.map((section) => (
        <section
          id={section.id}
          class="about-section"
          data-ngx-section={section.sectionId}
          data-ngx-label={section.sectionLabel}
          data-ngx-focusable="true"
        >
          <div class="about-section-inner">
            <h2>{section.title}</h2>
            <div class={`about-box ${section.boxClassName}`}>
              <div class="about-box-content">
                {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
                {
                  section.links && (
                    <p class="about-business-links">
                      {section.links.map((link) => <a href={link.href}>{link.label}</a>)}
                    </p>
                  )
                }
              </div>
              <div class="about-box-media" aria-hidden="true"></div>
            </div>
          </div>
        </section>
      ))
    }
  </main>
</MainLayout>

<style>
  .about-page {
    background: #03070f;
    padding-bottom: var(--space-16);
  }

  .about-hero,
  .about-section {
    width: 100%;
  }

  .about-hero {
    margin-top: var(--space-2);
    min-height: 390px;
    background:
      linear-gradient(to bottom, rgba(3, 8, 17, 0.3), rgba(3, 8, 17, 0.55)),
      url('/about/man_on_planet.png') center center / cover no-repeat;
    border-top: 1px solid var(--hero-edge-border);
    border-bottom: 1px solid var(--hero-edge-border);
    display: flex;
    align-items: center;
  }

  .about-hero-inner,
  .about-section-inner {
    width: var(--content-shell-width-desktop);
    margin: 0 auto;
  }

  .about-hero-inner {
    position: relative;
    padding: var(--space-8) 0;
    margin: 0 auto;
  }

  .about-hero-inner::before {
    content: '';
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    top: var(--space-2);
    bottom: var(--space-2);
    background: rgba(8, 13, 23, 0.42);
    border-top: 1px solid var(--hero-strip-border);
    border-bottom: 1px solid var(--hero-strip-border);
    pointer-events: none;

    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .about-hero-copy {
    position: relative;
    z-index: 1;
    width: min(560px, 100%);
    display: grid;
    gap: var(--space-3);
  }

  .about-kicker {
    margin: 0;
    font-size: clamp(var(--text-xl), 3.3vw, 2.1rem);
    line-height: var(--leading-tight);
  }

  .about-intro-text {
    margin: 0;
    font-size: clamp(var(--text-base), 2vw, var(--text-xl));
    max-width: 36ch;
  }

  .about-cta {
    margin-top: var(--space-4);
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    background: var(--button-muted-bg);
    border: 1px solid var(--button-muted-border);
    color: #e8f0ff;
    text-decoration: none;
    font-size: var(--text-sm);
  }

  .about-cta:hover {
    background: var(--button-muted-hover);
  }

  .about-section {
    margin-top: var(--space-8);
  }

  .about-section h2 {
    margin: 0 0 var(--space-3);
    font-size: clamp(var(--text-xl), 3vw, 2.2rem);
  }

  .about-box {
    background: var(--surface-panel);
    border: 1px solid var(--border-muted-strong);
    padding: var(--space-4);
    display: flex;
    gap: var(--space-4);
    overflow: hidden;
    align-items: stretch;
    min-height: 96px;
  }

  .about-box-content {
    flex: 1;
    min-width: 0;
  }

  .about-box-media {
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center;
    border-left: 0;
    flex: 0 0 auto;
    background-color: rgba(2, 8, 20, 0.62);
  }

  .about-box--who .about-box-media {
    width: 250px;
    background-image: linear-gradient(to left, rgba(4, 8, 16, 0.1), rgba(4, 8, 16, 0.88)), url('/about/cave.png');
    background-position: 72% center;
    background-size: contain;
  }

  .about-box--productivity {
    align-items: stretch;
  }

  .about-box--productivity .about-box-media {
    order: -1;
    width: 272px;
    border-left: 0;
    border-right: 0;
    background-color: rgba(2, 8, 20, 0.55);
    background-size: contain;
    background-position: 52% center;
    background-image: linear-gradient(to right, rgba(4, 8, 16, 0.15), rgba(4, 8, 16, 0.78)), url('/about/brain.png');
  }

  .about-box--hobbies .about-box-media {
    width: 236px;
    background-image: linear-gradient(to left, rgba(4, 8, 16, 0.1), rgba(4, 8, 16, 0.9)), url('/about/space_spaceship.png');
    background-position: right center;
    background-size: auto 100%;
  }

  .about-box--business .about-box-media {
    order: -1;
    width: 216px;
    border-left: 0;
    border-right: 0;
    background-image: linear-gradient(to left, rgba(4, 8, 16, 0.2), rgba(4, 8, 16, 0.94)), url('/about/space.png');
    background-position: center center;
    background-size: auto 100%;
  }

  .about-box p {
    margin: 0;
    color: color-mix(in srgb, var(--text-primary) 92%, transparent);
    line-height: 1.45;
    font-size: 15px;
  }

  .about-box p + p {
    margin-top: var(--space-4);
  }

  .about-business-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .about-business-links a {
    color: var(--text-accent);
    text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--text-accent) 32%, transparent);
    padding: var(--space-1) var(--space-3);
  }

  @media (max-width: 720px) {
    .about-page { padding-bottom: var(--space-10); }

    .about-hero-inner,
    .about-section-inner {
      width: var(--content-shell-width-mobile);
    }

    .about-hero {
      margin-top: var(--space-4);
      min-height: 280px;
      background-position: 62% center;
    }

    .about-hero-copy {
      width: min(440px, 100%);
    }

    .about-hero-inner::before {
      top: var(--space-1);
      bottom: var(--space-1);
    }

    .about-kicker {
      font-size: var(--text-lg);
    }

    .about-intro-text {
      font-size: var(--text-base);
    }

    .about-section {
      margin-top: var(--content-shell-margin-top-mobile);
    }

    .about-section h2 {
      font-size: clamp(var(--text-lg), 6vw, var(--text-xl));
    }

    .about-box {
      display: block;
      padding: var(--space-3);
    }

    .about-box-media {
      width: 100% !important;
      min-height: 120px;
      margin-top: var(--space-3);
      border-left: 0;
      border-right: 0;
      border-top: 0;
      background-size: cover !important;
      background-position: center !important;
    }

    .about-box--productivity .about-box-media {
      order: initial;
    }

    .about-box--business .about-box-media {
      order: initial;
      border-right: 0;
    }
  }
</style>
