---
import PageHero from "../components/astro/PageHero.astro";
import MainLayout from "../layouts/MainLayout.astro";
import { heroImages } from "../data/image-assets";

const homeSections = [
  {
    href: "/",
    title: "",
    description: "",
    isCurrent: true,
  },
  {
    href: "/about",
    title: "About",
    description:
      "Personal background, worldview, hobbies, and what drives my work.",
  },
  {
    href: "/portfolio",
    title: "Portfolio",
    description:
      "Selected projects, product work, and implementation case studies.",
  },
  {
    href: "/business",
    title: "Business",
    description: "Professional profile, services, and collaboration details.",
  },
  {
    href: "/resume",
    title: "Resume",
    description: "Experience timeline and role-focused summary.",
  },
  {
    href: "/hobbies",
    title: "Hobbies",
    description: "Interests, experiments, and non-client creative projects.",
  },
];
---

<MainLayout
  title="Home"
  seoTitle="Nour Gaser | Home"
  description="Welcome to nourgaser.com. Explore personal and professional pages including portfolio, skills, business profile, hobbies, resume, and writing."
  ogImage={heroImages.space3}
>
  <main
    class="home-page"
    data-ngx-section="home"
    data-ngx-label="Home"
    data-ngx-focusable="true"
    data-ngx-route="/"
  >
    <PageHero
      kicker="Hello, stranger"
      title="Welcome to nourgaser.com"
      description="Glad you found my neck of the woods. Here you'll find both personal and professional information about me, alongside some other random fun (in my opinion) things."
      image={heroImages.space3}
      imageAlt="Hero artwork with a sword in a cosmic landscape"
      ctaHref="#site-map"
      ctaLabel="Explore sections"
      sectionId="home-intro"
      sectionLabel="Home Intro"
      copyWidth="min(640px, 100%)"
      descriptionMaxWidth="52ch"
      mobileImagePosition="62% center"
    />

    <section
      id="site-map"
      class="home-links-section"
      data-ngx-section="home-links"
      data-ngx-label="Home Links"
      data-ngx-focusable="true"
    >
      <div class="home-links-inner">
        <h1>Website map</h1>
        <p class="home-links-lead">
          We all have to start somewhere... Including you, right now, make your choice. :)
        </p>
        <nav aria-label="Site sections" class="home-links-grid">
          {
            homeSections.map((section) => (
              section.isCurrent ? (
                <div
                  class="home-link-card home-link-card--home"
                  style={`--home-link-bg-image: url(${heroImages.sword.src});`}
                  aria-current="page"
                  data-ngx-frame
                >
                  <span class="home-link-title">{section.title}</span>
                  <span class="home-link-description">{section.description}</span>
                </div>
              ) : (
                <a href={section.href} class="home-link-card" data-ngx-frame>
                  <span class="home-link-title">{section.title}</span>
                  <span class="home-link-description">{section.description}</span>
                </a>
              )
            ))
          }
        </nav>
      </div>
    </section>
  </main>
</MainLayout>

<style>
  .home-page {
    background: #03070f;
  }

  .home-links-inner {
    width: var(--content-shell-width-desktop);
    margin: 0 auto;
    margin-top: var(--space-8);
    border: 1px solid var(--border-muted-strong);
    background: color-mix(in srgb, var(--surface-panel) 86%, #02060f);
    padding: var(--space-5);
  }

  .home-links-inner h1 {
    margin: 0;
    font-size: clamp(var(--text-xl), 3vw, var(--text-2xl));
  }

  .home-links-lead {
    margin: var(--space-2) 0 0;
    color: color-mix(in srgb, var(--text-primary) 90%, transparent);
    line-height: 1.5;
  }

  .home-links-grid {
    margin-top: var(--space-5);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .home-link-card {
    position: relative;
    display: grid;
    gap: var(--space-1);
    text-decoration: none;
    background: rgba(7, 12, 22, 0.72);
    border: 1px solid color-mix(in srgb, var(--text-accent) 28%, transparent);
    padding: var(--space-3);
    min-height: 120px;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease;
  }

  .home-link-card:not(.home-link-card--home):hover {
    border-color: color-mix(in srgb, var(--text-accent) 56%, transparent);
    background: rgba(9, 16, 30, 0.88);
  }

  .home-link-card--home {
    background-color: transparent;
    background-image: var(--home-link-bg-image);
    background-size: cover;
    background-position: center 45%;
    background-repeat: no-repeat;
    filter: brightness(1.22) contrast(1.1);
  }

  .home-link-card--home:hover {
    border-color: color-mix(in srgb, var(--text-accent) 56%, transparent);
    background-color: transparent;
    background-image: var(--home-link-bg-image);
    filter: brightness(1.26) contrast(1.12);
  }

  .home-link-title {
    font-size: var(--text-lg);
    color: var(--text-primary);
    line-height: var(--leading-tight);
  }

  .home-link-description {
    font-size: var(--text-sm);
    color: color-mix(in srgb, var(--text-primary) 92%, transparent);
    line-height: 1.45;
  }

  @media (max-width: 720px) {
    .home-page {
      padding-bottom: var(--space-10);
    }

    .home-links-inner {
      width: var(--content-shell-width-mobile);
      margin-top: var(--content-shell-margin-top-mobile);
      padding: var(--space-4);
    }

    .home-links-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .home-link-card {
      min-height: 106px;
    }
  }
</style>
