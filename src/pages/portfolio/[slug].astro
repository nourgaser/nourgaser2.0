---
import { getCollection, render } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import PageHero from '../../components/astro/PageHero.astro';
import ProjectShowcaseGallery from '../../components/astro/ProjectShowcaseGallery.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const orderedProjects = (await getCollection('projects')).sort((left, right) => {
  const leftOrder = left.data.order ?? Number.MAX_SAFE_INTEGER;
  const rightOrder = right.data.order ?? Number.MAX_SAFE_INTEGER;

  if (leftOrder !== rightOrder) {
    return leftOrder - rightOrder;
  }

  return left.data.title.localeCompare(right.data.title);
});

const projectIndex = orderedProjects.findIndex((entry) => entry.id === project.id);
const previousProject = projectIndex > 0 ? orderedProjects[projectIndex - 1] : undefined;
const nextProject = projectIndex >= 0 && projectIndex < orderedProjects.length - 1
  ? orderedProjects[projectIndex + 1]
  : undefined;
---

<MainLayout title={project.data.title} description={project.data.description ?? project.data.summary}>
  <main class="project-page" data-ngx-section="portfolio-detail" data-ngx-label={project.data.title} data-ngx-focusable="true" data-ngx-route={`/portfolio/${project.id}`}>
    <PageHero
      kicker={project.data.status}
      title={project.data.title}
      description={project.data.summary}
      image={project.data.coverImage ?? '/hero/space3.png'}
      sectionId="project-hero"
      sectionLabel="Project Hero"
      ctaHref="#project-showcase"
      ctaLabel="Jump to showcase"
    />

    <article class="project-shell">
      <header class="project-header" data-ngx-section="portfolio-header" data-ngx-label="Project Intro">
        <nav id="project-links" class="project-links" aria-label={`${project.data.title} project links`}>
          <a href="/portfolio/">Back to portfolio</a>
        </nav>

        {project.data.note && <p class="project-note">{project.data.note}</p>}
      </header>

      {
        project.data.media.length > 0 && (
          <section id="project-showcase">
            <ProjectShowcaseGallery
              title={project.data.title}
              media={project.data.media}
              tags={project.data.tags}
              links={project.data.links}
              previousTitle={previousProject?.data.title}
              previousSlug={previousProject?.id}
              nextTitle={nextProject?.data.title}
              nextSlug={nextProject?.id}
            />
          </section>
        )
      }

      <section class="project-content" data-ngx-section="portfolio-content" data-ngx-label="Project Content">
        <Content />
      </section>
    </article>
  </main>
</MainLayout>

<style>
  .project-page {
    background: #03070f;
    padding-bottom: var(--space-12);
  }

  .project-shell {
    width: var(--content-shell-width-desktop);
    margin: var(--space-8) auto;
    display: grid;
    gap: var(--space-6);
  }

  .project-header {
    background: var(--surface-panel);
    border: 1px solid var(--border-muted-strong);
    padding: var(--space-5);
    display: grid;
    gap: var(--space-3);
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .project-links a {
    color: var(--text-accent);
    text-decoration: none;
  }

  .project-note {
    margin: 0;
    max-width: 72ch;
    color: color-mix(in srgb, var(--text-primary) 76%, transparent);
  }

  .project-content {
    display: grid;
    gap: var(--space-4);
    max-width: 70ch;
  }

  .project-content :global(p) {
    margin: 0;
  }

  @media (max-width: 720px) {
    .project-page {
      padding-bottom: var(--space-10);
    }

    .project-shell {
      width: var(--content-shell-width-mobile);
      margin-top: var(--content-shell-margin-top-mobile);
      gap: var(--space-5);
    }
  }
</style>
