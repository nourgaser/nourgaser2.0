---
import { getCollection, render } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import PageHero from '../../components/astro/PageHero.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<MainLayout title={project.data.title} description={project.data.description ?? project.data.summary}>
  <main class="project-page" data-ngx-section="portfolio-detail" data-ngx-label={project.data.title} data-ngx-focusable="true" data-ngx-route={`/portfolio/${project.id}`}>
    <PageHero
      kicker={project.data.status}
      title={project.data.title}
      description={project.data.summary}
      image={project.data.coverImage ?? '/hero/space3.png'}
      sectionId="project-hero"
      sectionLabel="Project Hero"
      ctaHref="#project-links"
      ctaLabel="Jump to links"
    />

    <article class="project-shell">
      <header class="project-header">
        {project.data.note && <p class="project-note">{project.data.note}</p>}

        <ul class="project-tags" aria-label={`${project.data.title} tags`}>
          {project.data.tags.map((tag) => <li>{tag}</li>)}
        </ul>

        <nav id="project-links" class="project-links" aria-label={`${project.data.title} project links`}>
          <a href="/portfolio/">Back to portfolio</a>
          {project.data.links?.live && <a href={project.data.links.live} target="_blank" rel="noreferrer">Live</a>}
          {project.data.links?.source && <a href={project.data.links.source} target="_blank" rel="noreferrer">Source</a>}
          {project.data.links?.design && <a href={project.data.links.design} target="_blank" rel="noreferrer">Notes</a>}
        </nav>
      </header>

      {project.data.media.length > 0 && (
        <section class="project-media" data-ngx-section="portfolio-media" data-ngx-label="Project Media">
          {
            project.data.media.map((item) => (
              <figure class="project-media-item">
                {item.isVideo ? (
                  <video controls preload="metadata" playsinline>
                    <source src={item.path} type="video/mp4" />
                  </video>
                ) : (
                  <img src={item.path} alt={item.alt ?? project.data.title} loading="lazy" />
                )}
                {item.alt && <figcaption>{item.alt}</figcaption>}
              </figure>
            ))
          }
        </section>
      )}

      <section class="project-content" data-ngx-section="portfolio-content" data-ngx-label="Project Content">
        <Content />
      </section>
    </article>
  </main>
</MainLayout>

<style>
  .project-page {
    background: #03070f;
    padding-bottom: var(--space-14);
  }

  .project-shell {
    width: min(1240px, calc(100% - (var(--space-8) * 2)));
    margin: var(--space-8) auto 0;
  }

  .project-header {
    background: rgba(8, 12, 22, 0.72);
    border: 1px solid rgba(130, 130, 130, 0.52);
    padding: var(--space-5);
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }

  .project-note {
    margin: 0;
    max-width: 72ch;
  }

  .project-note {
    color: color-mix(in srgb, var(--text-primary) 76%, transparent);
  }

  .project-tags,
  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .project-tags {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .project-tags li {
    padding: var(--space-1) var(--space-3);
    border: 1px solid color-mix(in srgb, var(--text-accent) 40%, transparent);
    font-size: var(--text-sm);
  }

  .project-links a {
    color: var(--text-accent);
    text-decoration: none;
  }

  .project-media {
    display: grid;
    gap: var(--space-6);
    margin-bottom: var(--space-10);
  }

  .project-media-item {
    margin: 0;
    background: rgba(8, 12, 22, 0.72);
    border: 1px solid rgba(130, 130, 130, 0.52);
    overflow: hidden;
  }

  .project-media-item img,
  .project-media-item video {
    display: block;
    width: 100%;
    height: auto;
    background: #000;
  }

  .project-media-item figcaption {
    padding: var(--space-4);
    color: color-mix(in srgb, var(--text-primary) 86%, transparent);
    font-size: var(--text-sm);
  }

  .project-content {
    display: grid;
    gap: var(--space-4);
    max-width: 70ch;
  }

  .project-content :global(p) {
    margin: 0;
  }

  @media (max-width: 720px) {
    .project-page {
      padding-bottom: var(--space-10);
    }

    .project-shell {
      width: min(100% - (var(--space-4) * 2), 1240px);
      margin-top: var(--space-6);
    }
  }
</style>
