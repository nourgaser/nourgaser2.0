---
import { getCollection, render } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import PageHero from '../../components/astro/PageHero.astro';
import ProjectShowcaseGallery from '../../components/astro/ProjectShowcaseGallery.astro';
import ProjectNav from '../../components/astro/ProjectNav.astro';
import PortfolioProjectEnhancer from '../../components/svelte/PortfolioProjectEnhancer.svelte';
import { heroImages } from '../../data/image-assets';
import { portfolioCategoryLabels, portfolioCategoryOrder } from '../../data/pages/portfolio';

export async function getStaticPaths() {
  const projects = await getCollection('projects');

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const orderedProjects = (await getCollection('projects')).sort((left, right) => {
  const leftOrder = left.data.order ?? Number.MAX_SAFE_INTEGER;
  const rightOrder = right.data.order ?? Number.MAX_SAFE_INTEGER;

  if (leftOrder !== rightOrder) {
    return leftOrder - rightOrder;
  }

  return left.data.title.localeCompare(right.data.title);
});

const tocOrderedProjects = portfolioCategoryOrder.flatMap((category) =>
  orderedProjects.filter((entry) => entry.data.category === category)
);

const projectIndex = tocOrderedProjects.findIndex((entry) => entry.id === project.id);
const previousProject = projectIndex > 0 ? tocOrderedProjects[projectIndex - 1] : undefined;
const nextProject = projectIndex >= 0 && projectIndex < tocOrderedProjects.length - 1
  ? tocOrderedProjects[projectIndex + 1]
  : undefined;

const navGroups = portfolioCategoryOrder
  .map((category) => ({
    category,
    label: portfolioCategoryLabels[category],
    projects: orderedProjects
      .filter((entry) => entry.data.category === category)
      .map((entry) => ({ id: entry.id, title: entry.data.title })),
  }))
  .filter((group) => group.projects.length > 0);
---

<MainLayout title={project.data.title} description={project.data.description ?? project.data.summary}>
  <main class="project-page" data-project-page="true" data-ngx-section="portfolio-detail" data-ngx-label={project.data.title} data-ngx-focusable="true" data-ngx-route={`/portfolio/${project.id}`}>
    <PageHero
      kicker={project.data.status}
      title={project.data.title}
      description={project.data.summary}
      image={project.data.coverImage ?? heroImages.space3}
      sectionId="project-hero"
      sectionLabel="Project Hero"
      ctaHref="#project-showcase"
      ctaLabel="Jump to showcase"
    />

    <article class="project-shell">
      <header class="project-header" data-ngx-section="portfolio-header" data-ngx-label="Project Intro">
        <div id="project-links" class="project-links">
          <a class="project-back-link" href="/portfolio/">Back to portfolio</a>
        </div>

        {project.data.note && <p class="project-note">{project.data.note}</p>}
      </header>

      <div class="project-body">
        <aside class="project-sidebar">
          <ProjectNav currentSlug={project.id} groups={navGroups} />
        </aside>

        <div class="project-main">

          {
            project.data.media.length > 0 && (
              <section id="project-showcase">
                <ProjectShowcaseGallery
                  title={project.data.title}
                  media={project.data.media}
                  tags={project.data.tags}
                  links={project.data.links}
                  previousTitle={previousProject?.data.title}
                  previousSlug={previousProject?.id}
                  nextTitle={nextProject?.data.title}
                  nextSlug={nextProject?.id}
                />
              </section>
            )
          }

          <section class="project-content" data-ngx-section="portfolio-content" data-ngx-label="Project Content">
            <Content />
          </section>
        </div>
      </div>
    </article>
  </main>

  <PortfolioProjectEnhancer client:idle rootSelector='main[data-project-page="true"]' />
</MainLayout>

<style>
  .project-page {
    background: #03070f;
    padding-bottom: var(--space-12);
  }

  .project-shell {
    width: var(--content-shell-width-desktop);
    margin: var(--space-8) auto;
    display: grid;
    gap: var(--space-6);
  }

  .project-body {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: var(--space-6);
    align-items: start;
  }

  .project-sidebar {
    min-width: 0;
  }

  .project-main {
    display: grid;
    gap: var(--space-6);
    min-width: 0;
  }

  #project-showcase {
    scroll-margin-top: calc(var(--nav-height) + var(--space-8));
  }

  .project-header {
    background: var(--surface-panel);
    border: 1px solid var(--border-muted-strong);
    padding: var(--space-5);
    display: grid;
    gap: var(--space-3);
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .project-links a {
    color: var(--text-accent);
    text-decoration: none;
  }

  .project-back-link {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--border-muted-strong);
    background: color-mix(in srgb, var(--bg-terminal-header) 44%, transparent);
  }

  .project-back-link:hover {
    color: var(--text-primary);
    border-color: color-mix(in srgb, var(--text-accent) 55%, transparent);
    background: color-mix(in srgb, var(--bg-terminal-header) 68%, transparent);
  }

  .project-note {
    margin: 0;
    max-width: 72ch;
    color: color-mix(in srgb, var(--text-primary) 76%, transparent);
  }

  .project-content {
    display: grid;
    gap: var(--space-4);
    max-width: 70ch;
  }

  .project-content :global(p) {
    margin: 0;
  }

  @media (max-width: 960px) {
    .project-page {
      padding-bottom: var(--space-10);
    }

    .project-shell {
      width: var(--content-shell-width-mobile);
      margin-top: var(--content-shell-margin-top-mobile);
      gap: var(--space-5);
    }

    .project-body {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }
</style>
