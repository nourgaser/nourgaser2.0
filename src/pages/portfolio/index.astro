---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import PageHero from '../../components/astro/PageHero.astro';
import { portfolioCategoryMeta, portfolioCategoryOrder, portfolioPageContent } from '../../data/pages/portfolio';

const projects = (await getCollection('projects')).sort((left, right) => {
  const leftOrder = left.data.order ?? Number.MAX_SAFE_INTEGER;
  const rightOrder = right.data.order ?? Number.MAX_SAFE_INTEGER;

  if (leftOrder !== rightOrder) {
    return leftOrder - rightOrder;
  }

  return left.data.title.localeCompare(right.data.title);
});

const groupedProjects = portfolioCategoryOrder
  .map((category) => ({
    category,
    projects: projects.filter((project) => project.data.category === category),
  }))
  .filter((entry) => entry.projects.length > 0);
---

<MainLayout title="Portfolio" description={portfolioPageContent.seoDescription}>
  <main class="portfolio-page" data-ngx-section="portfolio" data-ngx-label="Portfolio" data-ngx-focusable="true" data-ngx-route="/portfolio">
    <PageHero
      kicker={portfolioPageContent.hero.kicker}
      title={portfolioPageContent.hero.title}
      description={portfolioPageContent.hero.description}
      image={portfolioPageContent.hero.image}
      sectionId={portfolioPageContent.hero.sectionId}
      sectionLabel={portfolioPageContent.hero.sectionLabel}
    />

    {
      groupedProjects.map((entry) => (
        <section
          class="portfolio-shell portfolio-category"
          data-ngx-section={`portfolio-${entry.category}`}
          data-ngx-label={portfolioCategoryMeta[entry.category].title}
        >
          <h2>{portfolioCategoryMeta[entry.category].title}</h2>
          <p class="portfolio-category-intro">{portfolioCategoryMeta[entry.category].description}</p>

          <div class="portfolio-grid">
            {entry.projects.map((project) => (
              <article class="portfolio-card">
                {project.data.coverImage && (
                  <a href={`/portfolio/${project.id}/`} class="portfolio-card-media">
                    <Picture
                      src={project.data.coverImage}
                      alt={project.data.title}
                      formats={['avif', 'webp']}
                      width={640}
                      height={400}
                      sizes="(min-width: 1100px) 30vw, (min-width: 720px) 46vw, 100vw"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                )}

                <div class="portfolio-card-body">
                  <div class="portfolio-card-meta">
                    <p class="portfolio-status">{project.data.status}</p>
                    {project.data.featured && <p class="portfolio-featured">featured</p>}
                  </div>

                  <h3>
                    <a href={`/portfolio/${project.id}/`}>{project.data.title}</a>
                  </h3>

                  <p>{project.data.summary}</p>

                  {project.data.note && <p class="portfolio-note">{project.data.note}</p>}

                  <ul class="portfolio-tags" aria-label={`${project.data.title} tags`}>
                    {project.data.tags.map((tag) => <li>{tag}</li>)}
                  </ul>

                  <div class="portfolio-links" aria-label={`${project.data.title} links`}>
                    <a href={`/portfolio/${project.id}/`}>Open</a>
                    {project.data.links?.live && (
                      <a href={project.data.links.live} target="_blank" rel="noreferrer">Live</a>
                    )}
                    {project.data.links?.source && (
                      <a href={project.data.links.source} target="_blank" rel="noreferrer">Source</a>
                    )}
                    {project.data.links?.design && (
                      <a href={project.data.links.design} target="_blank" rel="noreferrer">Notes</a>
                    )}
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>
      ))
    }
  </main>
</MainLayout>

<style>
  .portfolio-page {
    background: #03070f;
    padding-bottom: var(--space-14);
  }

  .portfolio-shell {
    width: var(--content-shell-width-desktop);
    margin: var(--space-8) auto;
  }

  .portfolio-status,
  .portfolio-featured {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-accent);
    font-size: var(--text-sm);
  }

  .portfolio-category h2 {
    margin: 0;
    font-size: clamp(var(--text-2xl), 3vw, 2.25rem);
  }

  .portfolio-category-intro {
    margin: var(--space-3) 0 var(--space-6);
    max-width: 70ch;
    color: color-mix(in srgb, var(--text-primary) 84%, transparent);
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-8);
  }

  .portfolio-card {
    background: var(--surface-panel);
    border: 1px solid var(--border-muted-strong);
    overflow: hidden;
  }

  .portfolio-card-media {
    display: block;
    aspect-ratio: 16 / 10;
    background: color-mix(in srgb, var(--bg-nav) 80%, transparent);
  }

  .portfolio-card-media :global(picture),
  .portfolio-card-media :global(img) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .portfolio-card-media :global(img) {
    object-fit: cover;
  }

  .portfolio-card-body {
    padding: var(--space-6);
  }

  .portfolio-card-meta,
  .portfolio-links,
  .portfolio-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .portfolio-card-body h3 {
    margin: var(--space-4) 0 var(--space-3);
    font-size: var(--text-xl);
  }

  .portfolio-card-body h3 a {
    color: var(--text-primary);
    text-decoration: none;
  }

  .portfolio-note {
    color: color-mix(in srgb, var(--text-primary) 76%, transparent);
  }

  .portfolio-tags {
    list-style: none;
    padding: 0;
    margin: var(--space-5) 0 0;
  }

  .portfolio-tags li {
    padding: var(--space-1) var(--space-3);
    border: 1px solid color-mix(in srgb, var(--text-accent) 40%, transparent);
    font-size: var(--text-sm);
    color: color-mix(in srgb, var(--text-primary) 88%, transparent);
  }

  .portfolio-links {
    margin-top: var(--content-shell-margin-top-mobile);
  }

  .portfolio-links a {
    color: var(--text-accent);
    text-decoration: none;
  }

  @media (max-width: 720px) {
    .portfolio-page {
      padding-bottom: var(--space-10);
    }

    .portfolio-shell {
      width: var(--content-shell-width-mobile);
      margin-top: var(--content-shell-margin-top-mobile);
    }
  }
</style>
