---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Resume" description="Latest resume for Nour Gaser Algendi.">
  <main data-ngx-section="resume" data-ngx-label="Resume" data-ngx-focusable="true" data-ngx-route="/resume">
    <section class="resume-page resume-hero" aria-labelledby="resume-heading">
      <p class="resume-kicker">Professional document</p>
      <h1 id="resume-heading">Resume</h1>
      <p>Download or preview the latest resume.</p>
      <p class="resume-actions">
        <a href="/resume-nour-gaser-jan-2026.pdf" download>Download PDF</a>
        <a href="/business">Go to business profile</a>
      </p>
    </section>

    <section class="resume-page resume-preview" data-ngx-section="resume-preview" data-ngx-label="Resume Preview">
      <iframe src="/resume-nour-gaser-jan-2026.pdf" title="Resume PDF preview"></iframe>
    </section>
  </main>
</MainLayout>

<style>
  .resume-page {
    width: min(1120px, calc(100% - (var(--space-10) * 2)));
    margin: 0 auto;
  }

  .resume-hero {
    padding: var(--space-16) 0 var(--space-8);
    display: grid;
    gap: var(--space-4);
  }

  .resume-kicker {
    color: var(--text-accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--text-sm);
    margin: 0;
  }

  .resume-hero h1 {
    margin: 0;
    font-size: clamp(var(--text-2xl), 6vw, 4rem);
    line-height: var(--leading-tight);
  }

  .resume-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
  }

  .resume-actions a {
    color: var(--text-accent);
    text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--text-accent) 32%, transparent);
    padding: var(--space-2) var(--space-4);
  }

  .resume-preview {
    padding-bottom: var(--space-16);
  }

  .resume-preview iframe {
    width: 100%;
    min-height: 72vh;
    border: 1px solid color-mix(in srgb, var(--text-accent) 20%, transparent);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--bg-terminal) 92%, transparent);
  }

  @media (max-width: 720px) {
    .resume-page {
      width: min(100% - (var(--space-4) * 2), 1120px);
    }

    .resume-hero {
      padding-top: var(--space-10);
    }

    .resume-preview iframe {
      min-height: 66vh;
    }
  }
</style>
