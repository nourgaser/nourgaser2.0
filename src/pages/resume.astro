---
import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/astro/PageHero.astro';
import { resumePageContent } from '../data/pages/resume';
---

<MainLayout title="Resume" description={resumePageContent.seoDescription} ogImage={resumePageContent.hero.image}>
  <main class="resume-page" data-ngx-section="resume" data-ngx-label="Resume" data-ngx-focusable="true" data-ngx-route="/resume">
    <PageHero
      kicker={resumePageContent.hero.kicker}
      title={resumePageContent.hero.title}
      description={resumePageContent.hero.description}
      image={resumePageContent.hero.image}
      sectionId={resumePageContent.hero.sectionId}
      sectionLabel={resumePageContent.hero.sectionLabel}
    />

    <section class="resume-shell" data-ngx-section="resume-links" data-ngx-label="Resume Links">
      <p class="resume-actions" data-ngx-frame>
        {
          resumePageContent.actions.map((action) => (
            <a href={action.href} download={action.download}>{action.label}</a>
          ))
        }
      </p>
    </section>

    <section class="resume-shell resume-preview" data-ngx-section="resume-preview" data-ngx-label="Resume Preview" data-ngx-frame>
      <iframe src={resumePageContent.resumeFile} title={resumePageContent.previewTitle}></iframe>
    </section>
  </main>
</MainLayout>

<style>
  .resume-page {
    background: #03070f;
    padding-bottom: var(--space-14);
  }

  .resume-shell {
    width: var(--content-shell-width-desktop);
    margin: var(--space-8) auto;
  }

  .resume-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    background: var(--surface-panel);
    border: 1px solid var(--border-muted-strong);
    padding: var(--space-4);
  }

  .resume-actions a {
    color: var(--text-accent);
    text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--text-accent) 32%, transparent);
    padding: var(--space-2) var(--space-4);
  }

  .resume-preview iframe {
    width: 100%;
    min-height: 72vh;
    border: 1px solid var(--border-muted-strong);
    background: var(--surface-panel);
  }

  @media (max-width: 720px) {
    .resume-page {
      padding-bottom: var(--space-10);
    }

    .resume-shell {
      width: var(--content-shell-width-mobile);
      margin-top: var(--content-shell-margin-top-mobile);
    }

    .resume-preview iframe {
      min-height: 66vh;
    }
  }
</style>
