---
import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/astro/PageHero.astro';
---

<MainLayout title="Resume" description="Latest resume for Nour Gaser Algendi.">
  <main class="resume-page" data-ngx-section="resume" data-ngx-label="Resume" data-ngx-focusable="true" data-ngx-route="/resume">
    <PageHero
      kicker="Professional document"
      title="Resume"
      description="Download or preview the latest resume."
      image="/hero/galaxy.png"
      sectionId="resume-hero"
      sectionLabel="Resume Hero"
    />

    <section class="resume-shell" data-ngx-section="resume-links" data-ngx-label="Resume Links">
      <p class="resume-actions">
        <a href="/resume-nour-gaser-jan-2026.pdf" download>Download PDF</a>
        <a href="/business">Go to business profile</a>
      </p>
    </section>

    <section class="resume-shell resume-preview" data-ngx-section="resume-preview" data-ngx-label="Resume Preview">
      <iframe src="/resume-nour-gaser-jan-2026.pdf" title="Resume PDF preview"></iframe>
    </section>
  </main>
</MainLayout>

<style>
  .resume-page {
    background: #03070f;
    padding-bottom: var(--space-14);
  }

  .resume-shell {
    width: min(1240px, calc(100% - (var(--space-8) * 2)));
    margin: var(--space-8) auto 0;
  }

  .resume-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    background: rgba(8, 12, 22, 0.72);
    border: 1px solid rgba(100, 157, 226, 0.6);
    padding: var(--space-4);
  }

  .resume-actions a {
    color: var(--text-accent);
    text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--text-accent) 32%, transparent);
    padding: var(--space-2) var(--space-4);
  }

  .resume-preview iframe {
    width: 100%;
    min-height: 72vh;
    border: 1px solid rgba(100, 157, 226, 0.6);
    background: rgba(8, 12, 22, 0.72);
  }

  @media (max-width: 720px) {
    .resume-page {
      padding-bottom: var(--space-10);
    }

    .resume-shell {
      width: min(100% - (var(--space-4) * 2), 1240px);
      margin-top: var(--space-6);
    }

    .resume-preview iframe {
      min-height: 66vh;
    }
  }
</style>
