---
import MainLayout from '../layouts/MainLayout.astro';
import { skillCategories } from '../data/skills';
---

<MainLayout title="Skills" description="Current skills and technical strengths across engineering, infrastructure, and creative development.">
  <main data-ngx-section="skills" data-ngx-label="Skills" data-ngx-focusable="true" data-ngx-route="/skills">
    <section class="skills-page skills-hero" aria-labelledby="skills-heading">
      <p class="skills-kicker">Skills and strengths</p>
      <h1 id="skills-heading">Skills</h1>
      <p>
        Curated from current professional experience, public projects, and ongoing research work.
      </p>
    </section>

    <section class="skills-page skills-grid" data-ngx-section="skills-categories" data-ngx-label="Skill Categories">
      {
        skillCategories.map((category) => (
          <article class="skills-card">
            <h2>{category.name}</h2>
            <ul>
              {category.items.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))
      }
    </section>
  </main>
</MainLayout>

<style>
  .skills-page {
    width: min(1120px, calc(100% - (var(--space-10) * 2)));
    margin: 0 auto;
  }

  .skills-hero {
    padding: var(--space-16) 0 var(--space-10);
    display: grid;
    gap: var(--space-4);
  }

  .skills-hero > p:not(.skills-kicker) {
    max-width: 74ch;
  }

  .skills-kicker {
    color: var(--text-accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--text-sm);
    margin: 0;
  }

  .skills-hero h1 {
    margin: 0;
    line-height: var(--leading-tight);
    font-size: clamp(var(--text-2xl), 6vw, 4rem);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: var(--space-6);
    padding-bottom: var(--space-16);
  }

  .skills-card {
    background: color-mix(in srgb, var(--bg-terminal) 92%, transparent);
    border: 1px solid color-mix(in srgb, var(--text-accent) 16%, transparent);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
  }

  .skills-card h2 {
    margin: 0 0 var(--space-4);
    font-size: var(--text-xl);
  }

  .skills-card ul {
    margin: 0;
    padding-left: var(--space-5);
    display: grid;
    gap: var(--space-2);
  }

  @media (max-width: 720px) {
    .skills-page {
      width: min(100% - (var(--space-4) * 2), 1120px);
    }

    .skills-hero {
      padding-top: var(--space-10);
    }
  }
</style>
