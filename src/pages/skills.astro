---
import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/astro/PageHero.astro';
import { skillCategories } from '../data/skills';
---

<MainLayout title="Skills" description="Current skills and technical strengths across engineering, infrastructure, and creative development.">
  <main class="skills-page" data-ngx-section="skills" data-ngx-label="Skills" data-ngx-focusable="true" data-ngx-route="/skills">
    <PageHero
      kicker="Skills and strengths"
      title="Skills"
      description="Curated from current professional experience, public projects, and ongoing research work."
      image="/hero/double_sunset.png"
      sectionId="skills-hero"
      sectionLabel="Skills Hero"
    />

    <section class="skills-shell skills-grid" data-ngx-section="skills-categories" data-ngx-label="Skill Categories">
      {
        skillCategories.map((category) => (
          <article class="skills-card">
            <h2>{category.name}</h2>
            <ul>
              {category.items.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))
      }
    </section>
  </main>
</MainLayout>

<style>
  .skills-page {
    background: #03070f;
    padding-bottom: var(--space-14);
  }

  .skills-shell {
    width: min(1240px, calc(100% - (var(--space-8) * 2)));
    margin: var(--space-8) auto 0;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: var(--space-6);
  }

  .skills-card {
    background: rgba(8, 12, 22, 0.72);
    border: 1px solid rgba(130, 130, 130, 0.52);
    padding: var(--space-5);
  }

  .skills-card h2 {
    margin: 0 0 var(--space-4);
    font-size: var(--text-xl);
  }

  .skills-card ul {
    margin: 0;
    padding-left: var(--space-5);
    display: grid;
    gap: var(--space-2);
  }

  @media (max-width: 720px) {
    .skills-page {
      padding-bottom: var(--space-10);
    }

    .skills-shell {
      width: min(100% - (var(--space-4) * 2), 1240px);
      margin-top: var(--space-6);
    }
  }
</style>
